# Modèle versionné — ne JAMAIS y mettre de vraie valeur.
# Copier vers .env.local (ignoré par git) et remplir là-bas :
#   cp .env.example .env.local

# Supabase
# URL : Project Settings → Data API, ou https://<ref>.supabase.co
#       où <ref> est le segment de supabase.com/dashboard/project/<ref>
# ⚠ URL RACINE, sans /rest/v1 — supabase-js ajoute ce chemin lui-même.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé : Project Settings → API Keys → « anon / public » (eyJ…)
#       ou la nouvelle « publishable » (sb_publishable_…). Jamais la clé secrète.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — platform.openai.com → API keys → Create new secret key
OPENAI_API_KEY=

